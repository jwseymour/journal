{
  "name": "journal",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @journal/api",
    "dev:web": "npm run dev -w @journal/web",
    "rebuild-index": "npm run rebuild -w @journal/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundary": "./scripts/check-boundary.sh",
    "check": "npm run typecheck && npm run lint && npm run check:boundary && npm run test"
  }
}
