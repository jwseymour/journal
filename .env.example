# Copy this file to `.env` at the repository root and fill in what you need.
# Nothing here is committed — `.env*` is gitignored.

# ── Required ─────────────────────────────────────────────────────────────

# The journal repository root — the directory that contains `journal/`.
# Must already exist; the application never creates it. Still required even
# under STORAGE_BACKEND=s3 — it's where the safety-net local git mirror
# lives (`requirements.md` §7.4), and where `migrate-to-s3` reads from.
JOURNAL_DIR=/Users/you/Journal

# ── Server ───────────────────────────────────────────────────────────────

# HOST=127.0.0.1
# PORT=4319
# Comma-separated allowlist of browser origins. Never "*".
# WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# This server's own externally-reachable origin, only set once it's behind
# a real domain (e.g. `docs/deployment.md`'s EC2 + Caddy setup). Leave unset
# in local dev — there's no reverse proxy to make "my own URL" ambiguous.
# Used for the Google OAuth redirect_uri and the Host-header allowlist; see
# `publicUrl`'s doc comment in `config.ts` for why this can't just be
# inferred from the request.
# PUBLIC_URL=https://api.example.com

# ── Storage backend (`plan.md` M11) ─────────────────────────────────────

# `fs` (default, local directory) or `s3` (canonical store lives in S3).
# STORAGE_BACKEND=fs

# Required when STORAGE_BACKEND=s3.
# S3_BUCKET=your-journal-bucket
# AWS_REGION=eu-west-2
# Omit to fall back to the default AWS credential chain (shared config file,
# instance role, etc.) — set these only if you need to pin a specific key.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Auth (`plan.md` M11) ────────────────────────────────────────────────

# Auth is enforced only once SESSION_SECRET is set — leave it unset for
# local dev exactly as before this milestone. Generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# The one Google account/password allowed to sign in. Defaults to Jack's
# address if left unset.
# AUTHORIZED_EMAIL=seymour.w.jack@gmail.com

# From the Google Cloud Console OAuth client. Leave unset to disable Google
# sign-in (the password path below still works on its own).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# An argon2id hash, generated by `npm run set-password`. Leave unset to
# disable the password login path (Google sign-in still works on its own).
# AUTH_PASSWORD_HASH=

# ── Speech-to-text / embeddings (unchanged) ─────────────────────────────

# WHISPER_MODEL=Xenova/whisper-tiny.en
# WHISPER_CACHE_DIR=~/.cache/journal/whisper-models
# INDEX_DB_PATH=~/.cache/journal/index.db
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_CACHE_DIR=~/.cache/journal/embedding-models

# ── AI extraction / chat (unchanged) ────────────────────────────────────

# Vercel AI Gateway credential. Absent means extraction and chat are
# disabled, not a fatal boot error.
# AI_GATEWAY_API_KEY=
# EXTRACTION_MODEL=anthropic/claude-sonnet-5
# CHAT_MODEL=anthropic/claude-sonnet-5

# ── Frontend (apps/web) ──────────────────────────────────────────────────

# Where the Next.js *server process* reaches the API for its /api/* rewrite
# (`next.config.ts`). Distinct from NEXT_PUBLIC_API_URL below.
# API_INTERNAL_URL=http://127.0.0.1:4319

# Overrides the browser's own API base, which otherwise defaults to the
# relative /api path the rewrite above serves. Only needed if web and api
# are deployed to genuinely separate origins.
# NEXT_PUBLIC_API_URL=
